# Copy to .env and configure your existing OpenCTI installation.
OPENCTI_URL=http://opencti:8080
OPENCTI_TOKEN=CHANGE_ME
# Existing network shared by OpenCTI, RabbitMQ and these connectors.
OPENCTI_DOCKER_NETWORK=opencti_default
VYSION_API_URL=https://api.vysion.ai
VYSION_API_KEY=CHANGE_ME
VYSION_EXTERNAL_CONNECTOR_ID=CHANGE_ME_EXTERNAL_UUID_V4
VYSION_ENRICHMENT_CONNECTOR_ID=CHANGE_ME_ENRICHMENT_UUID_V4
# Only needed when enabling the independent vysion-wallets profile.
VYSION_WALLET_CONNECTOR_ID=CHANGE_ME_WALLET_UUID_V4
VYSION_ENABLE_IM=true
VYSION_ENABLE_LEAKS=false
VYSION_MAX_TLP=TLP:GREEN
VYSION_WALLET_PLATFORM=darknet
